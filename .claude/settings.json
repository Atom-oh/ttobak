{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/secret-scan.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/review-size-check.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-doc-sync.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/notify.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(> /dev/sda)",
      "Bash(chmod -R 777 /)",
      "Bash(curl * | bash)",
      "Bash(dd if=/dev/zero of=/dev/sda)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh pr merge --admin*)",
      "Bash(mkfs.*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(wget * | bash)"
    ],
    "allow": [
      "Bash(gh pr merge *)"
    ]
  },
  "extraKnownMarketplaces": {
    "rea": {
      "source": {
        "source": "github",
        "repo": "morluto/rea"
      }
    }
  },
  "enabledPlugins": {
    "rea@rea": true
  }
}
