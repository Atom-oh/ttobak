{
  "name": "ttobak-mcp",
  "version": "1.1.0",
  "description": "TTOBAK MCP server with stdio and authenticated Streamable HTTP",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs && npm run test:bundle",
    "test:bundle": "node scripts/check-bundle.mjs",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/ttobak-mcp.mjs --banner:js=\"#!/usr/bin/env node\" --define:TTOBAK_STANDALONE_STDIO=true",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "start:http": "node dist/index.js --transport http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "aws-jwt-verify": "5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
