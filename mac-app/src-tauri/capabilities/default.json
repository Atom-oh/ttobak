{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions for the TTOBAK Mac App. The window loads the remote production SPA (see tauri.conf.json's window `url`), not a local `tauri://` origin. Tauri checks the ACL for every command called from a remote origin, so this capability's `remote` grant must list each app command's `allow-*` permission (generated from `build.rs` COMMANDS) as well as event access (`core:default`).",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://ttobak.atomai.click"
    ]
  },
  "permissions": [
    "core:default",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-list-input-devices",
    "allow-switch-recording-input",
    "allow-recording-status",
    "allow-upload-recording",
    "allow-cleanup-recording",
    "allow-release-recording-power",
    "allow-list-leftover-recordings",
    "allow-start-listening",
    "allow-stop-listening",
    "allow-control-ready",
    "allow-control-reply",
    "allow-control-report-state",
    "allow-meeting-detection-get",
    "allow-meeting-detection-set-enabled",
    "allow-meeting-detection-respond",
    "allow-meeting-prompt-choose",
    "allow-caption-settings-get",
    "allow-caption-settings-set",
    "allow-caption-translate",
    "allow-caption-overlay-open",
    "allow-caption-overlay-close",
    "allow-caption-overlay-set-style",
    "allow-caption-overlay-push",
    "allow-intake-get-state",
    "allow-intake-set-schedule",
    "allow-intake-set-node-path",
    "allow-intake-launch-agent-off",
    "allow-intake-run-now",
    "allow-intake-setup",
    "allow-intake-login",
    "allow-intake-cancel",
    "allow-intake-check-adapter",
    "allow-intake-update-adapter",
    "allow-intake-refresh-path",
    "allow-setup-start",
    "allow-setup-get-state",
    "allow-intake-set-options",
    "allow-report-generate",
    "allow-report-cancel",
    "allow-report-get-state",
    "allow-report-settings-get",
    "allow-report-settings-set",
    "allow-report-slack-channels-refresh",
    "allow-team-sync-run",
    "allow-team-sync-cancel",
    "allow-team-sync-get-state"
  ]
}
