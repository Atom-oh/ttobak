# WhisperX benchmark image (Phase 1) -- separate from ./Dockerfile so the
# production image stays untouched while pyannote 4.x is evaluated.
# cu128 matches the DLC-validated combo (whisperx 3.8.x / torch 2.8 / CUDA 12.8).
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

# libpython3.12: pyannote.audio 4.x decodes audio via torchcodec, whose
# FFmpeg-6 variant (Ubuntu 24.04's apt ffmpeg is FFmpeg 6) links against
# libpython3.12.so.1.0 -- Ubuntu's `python3` package ships only the
# interpreter, not the shared library, so without this the first bench
# run's diarization died with RuntimeError at decode time (2026-08-31).
# On noble the shared library ships as the 64-bit-time_t transition
# package `libpython3.12t64` (which Provides: libpython3.12) -- try the
# real name first, fall back to the old name so the build works on either
# packaging state. Verify the built image with the runbook's torchcodec
# import smoke check, not `dpkg -s`.
# transcribe_whisperx.py also bypasses torchcodec by passing a preloaded
# waveform; this package makes the torchcodec path work regardless.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip ffmpeg && \
    (apt-get install -y --no-install-recommends libpython3.12t64 || \
     apt-get install -y --no-install-recommends libpython3.12) && \
    rm -rf /var/lib/apt/lists/*

# whisperx pins its own torch/pyannote.audio(>=4)/faster-whisper/ctranslate2
# versions -- don't pin them separately here, that's the version-skew trap
# the separate image exists to avoid. The extra index serves cu128 wheels.
# Exact-pinned (not a range): 3.8.6 is the AWS DLC-validated version for this
# cu128/torch 2.8 combo -- an unpinned range lets a future whisperx release
# silently drag in an unvalidated transitive dep set. boto3<2 matches the
# repo-wide convention (see root CLAUDE.md build commands).
RUN pip3 install --no-cache-dir --break-system-packages \
    --extra-index-url https://download.pytorch.org/whl/cu128 \
    "whisperx==3.8.6" "boto3<2"

# Whisper CT2 weights + diarization pipeline are loaded from S3 at runtime
# (same pattern as the legacy image; see whisper_common.stream_extract_tar).
COPY whisper_common.py transcribe_whisperx.py transcribe_fw_p4.py /app/
WORKDIR /app

# Non-root: the app only writes under /tmp (model/audio staging), so it
# needs no elevated filesystem access at runtime.
RUN useradd -m -u 10001 whisperx
USER whisperx

# ENTRYPOINT/CMD split (not a single ENTRYPOINT list) because ECS RunTask's
# containerOverrides can only replace the CMD part — the §3c hybrid bench
# engine (transcribe_fw_p4.py) is selected per run via
# `"command": ["transcribe_fw_p4.py"]`, which with a combined ENTRYPOINT
# would silently run transcribe_whisperx.py with an ignored extra argument.
ENTRYPOINT ["python3"]
CMD ["transcribe_whisperx.py"]
